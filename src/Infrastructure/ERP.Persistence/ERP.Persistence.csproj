<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ERP.Persistence
    ================
    Clean Architecture: Persistence (part of the outer Infrastructure ring).

    Implements ERP.Application's IApplicationDbContext using EF Core 8 against
    SQL Server Express. Owns migrations, entity type configurations (Fluent
    API - never data annotations, so mapping stays out of ERP.Domain),
    repository implementations, and the audit SaveChanges interceptor that
    fulfils the mandatory audit fields defined in the approved Database
    Design (Prompt 4) and Security/Audit Framework (Prompt 6).

    References ERP.Security only to obtain the ApplicationUser / ApplicationRole
    identity types required by IdentityDbContext's generic parameters -
    ERP.Security does NOT reference ERP.Persistence back, so no cycle exists.
  -->

  <PropertyGroup>
    <AssemblyName>ERP.Persistence</AssemblyName>
    <RootNamespace>ERP.Persistence</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\ERP.Domain\ERP.Domain.csproj" />
    <ProjectReference Include="..\..\Core\ERP.Application\ERP.Application.csproj" />
    <ProjectReference Include="..\..\Shared\ERP.Shared\ERP.Shared.csproj" />
    <ProjectReference Include="..\ERP.Security\ERP.Security.csproj" />
  </ItemGroup>

</Project>

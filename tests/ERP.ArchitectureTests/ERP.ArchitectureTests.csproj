<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ERP.ArchitectureTests
    ======================
    These tests do not test business behavior. They test that the SOLUTION
    STRUCTURE itself never drifts from the architecture approved in Prompt 3
    (Enterprise Software Architecture & Solution Blueprint), e.g.:
      - ERP.Domain has no dependency on any other project
      - ERP.Application never depends on Persistence/Infrastructure/Web
      - Only ERP.Web may depend on every layer
      - No project depends on ERP.Web (composition root is a leaf, never
        referenced by anything else)
    This project is the automated guardrail against "silent architecture
    drift" across the 10+ year lifetime of the system, called out explicitly
    in Prompt 13's Quality Gates ("Architecture Review").
  -->

  <PropertyGroup>
    <AssemblyName>ERP.ArchitectureTests</AssemblyName>
    <RootNamespace>ERP.ArchitectureTests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="NetArchTest.Rules" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Core\ERP.Domain\ERP.Domain.csproj" />
    <ProjectReference Include="..\..\src\Core\ERP.Application\ERP.Application.csproj" />
    <ProjectReference Include="..\..\src\Infrastructure\ERP.Persistence\ERP.Persistence.csproj" />
    <ProjectReference Include="..\..\src\Infrastructure\ERP.Infrastructure\ERP.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\Infrastructure\ERP.Security\ERP.Security.csproj" />
    <ProjectReference Include="..\..\src\Infrastructure\ERP.Workflow\ERP.Workflow.csproj" />
    <ProjectReference Include="..\..\src\Infrastructure\ERP.Notifications\ERP.Notifications.csproj" />
    <ProjectReference Include="..\..\src\Infrastructure\ERP.Reporting\ERP.Reporting.csproj" />
    <ProjectReference Include="..\..\src\Shared\ERP.Shared\ERP.Shared.csproj" />
    <ProjectReference Include="..\..\src\Presentation\ERP.Web\ERP.Web.csproj" />
  </ItemGroup>

</Project>
